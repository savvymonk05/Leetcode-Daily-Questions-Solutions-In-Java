class Solution {
    public List<List<Integer>> permute(int[] nums) {
        List<List<Integer>> ans = new ArrayList<>();
        helper(nums , 0, new boolean [nums.length] , new ArrayList<Integer>() , ans );
        return ans;
        
    }
    public void helper( int nums [] , int pos , boolean selected[] ,List<Integer> temp, List<List<Integer>> ans){
        if(pos == nums.length){
            ans.add(new ArrayList<>(temp));
            return;
        }
        for(int i = 0 ; i < nums.length ; i++){
            if(selected[i] == false){
                selected[i] = true;
                temp.add(nums[i]);
                helper(nums, pos+1 , selected , temp , ans );
                selected[i] = false;
                temp.remove(temp.size()-1);
                
            }
        }
    }
}
